#! A guard on possibly undefined operands freezes them, so the comparison and the subtraction it guards agree.

target = "evm-ethereum-osaka"

# regex: VALUE=\bv\d+\b
# check: func public %loaded_operand(v0.*i64) -> i64 {
# check: $(frozen=$VALUE).i64 = freeze v1;
# nextln: v2.i1 = gt 20.i64 $frozen;
# check: sub 20.i64 $frozen;
# not: usubo
# not: 99.i64
func public %loaded_operand(v0.*i64) -> i64 {
block0:
    v1.i64 = mload v0 i64;
    v2.i1 = gt 20.i64 v1;
    br v2 block1 block2;

block1:
    (v3.i64, v4.i1) = usubo 20.i64 v1;
    br v4 block3 block4;

block3:
    return 99.i64;

block4:
    return v3;

block2:
    return 0.i64;
}

# check: func public %unguarded_load_stays(v0.*i64, v1.*i64) -> i64 {
# not: freeze
func public %unguarded_load_stays(v0.*i64, v1.*i64) -> i64 {
block0:
    v2.i64 = mload v0 i64;
    v3.i64 = mload v1 i64;
    v4.i1 = gt v2 v3;
    br v4 block1 block2;

block1:
    v5.i64 = add v2 v3;
    return v5;

block2:
    return 0.i64;
}

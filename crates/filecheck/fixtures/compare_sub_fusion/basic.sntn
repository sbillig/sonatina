#! An unsigned comparison and the subtractions of its operands it dominates become one `usubo` when the difference is used in several blocks.

target = "evm-ethereum-osaka"

# sameln: func public %one_use_block_stays(v0.i64, v1.i64) -> i64 {
# check: v2.i1 = gt v1 v0;
# check: v3.i64 = sub v0 v1;
# not: usubo
func public %one_use_block_stays(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = gt v1 v0;
    br v2 block1 block2;

block1:
    return 0.i64;

block2:
    v3.i64 = sub v0 v1;
    return v3;
}

# regex: VALUE=\bv\d+\b
# sameln: func public %difference_on_several_edges(v0.i64, v1.i64, v2.i1) -> i64 {
# check: ($(diff=$VALUE).i64, $(borrow=$VALUE).i1) = usubo v0 v1;
# nextln: br $borrow block1 block2;
# not: gt
# not: sub
func public %difference_on_several_edges(v0.i64, v1.i64, v2.i1) -> i64 {
block0:
    v3.i1 = gt v1 v0;
    br v3 block1 block2;

block1:
    return 0.i64;

block2:
    v4.i64 = sub v0 v1;
    br v2 block3 block4;

block3:
    jump block5;

block4:
    jump block5;

block5:
    v5.i64 = phi (v4 block3) (v4 block4);
    return v5;
}

# regex: VALUE=\bv\d+\b
# sameln: func public %every_dominated_sub(v0.i64, v1.i64) -> i64 {
# check: ($(diff=$VALUE).i64, $(borrow=$VALUE).i1) = usubo v0 v1;
# nextln: br $borrow block1 block2;
# check: mul $diff $diff;
# not: lt
# not: sub
func public %every_dominated_sub(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = lt v0 v1;
    br v2 block1 block2;

block1:
    v3.i64 = sub v0 v1;
    return v3;

block2:
    v4.i64 = sub v0 v1;
    v5.i64 = sub v0 v1;
    v6.i64 = mul v4 v5;
    return v6;
}

# sameln: func public %earlier_sub_stays(v0.i64, v1.i64) -> i64 {
# check: v2.i64 = sub v0 v1;
# nextln: v3.i1 = lt v0 v1;
# not: usubo
func public %earlier_sub_stays(v0.i64, v1.i64) -> i64 {
block0:
    v2.i64 = sub v0 v1;
    v3.i1 = lt v0 v1;
    br v3 block1 block2;

block1:
    return 0.i64;

block2:
    return v2;
}

# sameln: func public %undominated_sub_stays(v0.i64, v1.i64, v2.i1) -> i64 {
# check: v3.i1 = lt v0 v1;
# check: v4.i64 = sub v0 v1;
# not: usubo
func public %undominated_sub_stays(v0.i64, v1.i64, v2.i1) -> i64 {
block0:
    br v2 block1 block2;

block1:
    v3.i1 = lt v0 v1;
    br v3 block3 block4;

block2:
    v4.i64 = sub v0 v1;
    return v4;

block3:
    return 0.i64;

block4:
    return 1.i64;
}

# sameln: func public %swapped_sub_stays(v0.i64, v1.i64) -> i64 {
# check: v2.i1 = lt v0 v1;
# check: v3.i64 = sub v1 v0;
# not: usubo
func public %swapped_sub_stays(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = lt v0 v1;
    br v2 block1 block2;

block1:
    v3.i64 = sub v1 v0;
    return v3;

block2:
    return 0.i64;
}

# sameln: func public %signed_compare_stays(v0.i64, v1.i64) -> i64 {
# check: v2.i1 = slt v0 v1;
# check: v3.i64 = sub v0 v1;
# not: usubo
func public %signed_compare_stays(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = slt v0 v1;
    br v2 block1 block2;

block1:
    return 0.i64;

block2:
    v3.i64 = sub v0 v1;
    return v3;
}

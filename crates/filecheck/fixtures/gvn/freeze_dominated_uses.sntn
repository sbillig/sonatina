#! A value GVN merges into a frozen operand below its freeze uses the freeze instead.

target = "evm-ethereum-osaka"

# regex: VALUE=\bv\d+\b
# sameln: func public %merged_below_freeze(v0.i64, v1.i64) -> i64 {
# check: v2.i64 = add v0 v1;
# check: $(frozen=$VALUE).i64 = freeze v2;
# nextln: v6.i64 = mul $frozen $frozen;
# check: return v2;
func public %merged_below_freeze(v0.i64, v1.i64) -> i64 {
block0:
    v2.i64 = add v0 v1;
    v3.i1 = lt v0 v1;
    br v3 block1 block2;

block1:
    v4.i64 = freeze v2;
    v5.i64 = add v0 v1;
    v6.i64 = mul v4 v5;
    return v6;

block2:
    return v2;
}

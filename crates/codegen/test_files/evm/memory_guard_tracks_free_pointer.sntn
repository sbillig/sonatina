#! evm.case: guard_observes_raw_allocation
#!   calldata:
#!   expect: return u256(32)

target = "evm-ethereum-osaka"

func public %entry() {
block0:
    v0.i256 = evm_memory_guard 128.i256;
    mstore 64.i256 v0 i256;
    v1.i256 = add v0 32.i256;
    mstore 64.i256 v1 i256;
    v2.i256 = evm_memory_guard 128.i256;
    v3.i256 = sub v2 v0;
    mstore 0.i256 v3 i256;
    evm_return 0.i256 32.i256;
}

object @Contract { section runtime { entry %entry; } }

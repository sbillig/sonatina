#! evm.config: { stack_reach: 4 }
#! evm.case: recursive_raw_allocator
#!   calldata:
#!   expect: return u256(306)

target = "evm-ethereum-osaka"

func public %recursive(v0.i256) -> i256 {
block0:
    v1.*i256 = alloca i256;
    mstore v1 v0 i256;

    v2.i256 = mload 64.i256 i256;
    v3.i256 = add v0 100.i256;
    mstore v2 v3 i256;
    v4.i256 = add v2 32.i256;
    mstore 64.i256 v4 i256;

    v5.i1 = eq v0 0.i256;
    br v5 block1 block2;

block1:
    v6.i256 = mload v1 i256;
    v7.i256 = mload v2 i256;
    v8.i256 = add v6 v7;
    return v8;

block2:
    v9.i256 = sub v0 1.i256;
    v10.i256 = call %recursive v9;
    v11.i256 = mload v1 i256;
    v12.i256 = mload v2 i256;
    v13.i256 = add v10 v11;
    v14.i256 = add v13 v12;
    return v14;
}

func public %entry() {
block0:
    v0.i256 = evm_memory_guard 128.i256;
    mstore 64.i256 v0 i256;
    v1.i256 = call %recursive 2.i256;
    mstore 0.i256 v1 i256;
    evm_return 0.i256 32.i256;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}

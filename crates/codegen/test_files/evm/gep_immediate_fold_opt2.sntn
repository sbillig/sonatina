#! evm.config: { vcode: true, bytecode_hex: false, stackify_trace: false, evm_trace: false, opt: 2 }
#! evm.case: folded_and_fallback
#!   calldata: u256(32) u256(64)
#!   expect: return u256(27)

# The machine pass round folds the address of a GEP with constant indices off a
# static-arena alloca to an immediate, and scales a dynamic index by a shift.
# The first two functions read back through an address offset by an argument,
# so the optimizer keeps their stores and allocas.
target = "evm-ethereum-osaka"

type @triple = { i256, i256, i256 };

func public %fold_simple(v9.i256) -> i256 {
    block0:
        v0.*@triple = alloca @triple;
        v1.*i256 = gep v0 0.i8 1.i8;
        mstore v1 7.i256 i256;
        v2.i256 = ptr_to_int v0 i256;
        v3.i256 = add v2 v9;
        v4.i256 = mload v3 i256;
        return v4;
}

func public %fold_nested(v9.i256) -> i256 {
    block0:
        v0.*@triple = alloca @triple;
        v1.*i256 = gep v0 0.i8 0.i8;
        v2.*i256 = gep v1 2.i8;
        mstore v2 9.i256 i256;
        v3.i256 = ptr_to_int v0 i256;
        v4.i256 = add v3 v9;
        v5.i256 = mload v4 i256;
        return v5;
}

func public %dynamic_index(v0.i8) -> i256 {
    block0:
        v1.*[i256; 3] = alloca [i256; 3];
        v2.*i256 = gep v1 0.i8 v0;
        mstore v2 11.i256 i256;
        v3.i256 = mload v2 i256;
        return v3;
}

func public %entry() {
    block0:
        v5.i256 = evm_calldata_load 0.i256;
        v6.i256 = evm_calldata_load 32.i256;
        v0.i256 = call %fold_simple v5;
        v1.i256 = call %fold_nested v6;
        v2.i256 = call %dynamic_index 1.i8;
        v3.i256 = add v0 v1;
        v4.i256 = add v3 v2;
        mstore 0.i32 v4 i256;
        evm_return 0.i8 32.i8;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}

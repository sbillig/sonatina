target = "evm-ethereum-osaka"

func public %entry(v0.i32) -> i32 {
    block0:
        v1.*i32 = alloca i32;
        mstore v1 1.i32 i32;
        jump block1;

    block1:
        v2.i32 = phi (0.i32 block0) (v5 block2);
        v3.i1 = lt v2 v0;
        br v3 block2 block3;

    block2:
        v4.i32 = mload v1 i32;
        v5.i32 = add v2 1.i32;
        v6.i32 = add v4 v5;
        mstore v1 v6 i32;
        jump block1;

    block3:
        v7.i32 = mload v1 i32;
        return v7;
}
